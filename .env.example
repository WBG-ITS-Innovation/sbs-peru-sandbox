# This project uses Azure OpenAI through WBG ITS, not personal OpenAI.
# Get your endpoint and deployment name from WBG IT or the Azure portal.
# WBG data-governance policy: model calls touching project content must go
# through WBG-tenanted Azure OpenAI. Personal openai.com keys are rejected
# by scripts/cross_review.py.
#
# Copy this file to .env (which is gitignored) and fill in real values.

# --- Azure OpenAI (the `cloud` model provider, ADR 0015) -------------------
# These four are read by CloudProvider
# (api/sbs_api/agents/providers/cloud.py) via Settings, under these exact
# bare names — no SBS_API_ prefix. All four are required for
# SBS_API_MODEL_PROVIDER=cloud; the provider refuses to construct and names
# the missing ones rather than starting up half-configured.
#
# API key. Never logged — CloudProvider redacts it from every message and
# exception it emits, and reports only whether it is present.
AZURE_OPENAI_API_KEY=
# Resource endpoint, including scheme and trailing slash, e.g.
# https://<resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
# DEPLOYMENT name, not the base model name — Azure routes on the deployment.
AZURE_OPENAI_DEPLOYMENT=
# REST API version, e.g. 2024-06-01. Must support the `tools` parameter:
# the agent runtime is tool-calling only and the boot healthcheck fails a
# deployment that returns no tool_calls.
AZURE_OPENAI_API_VERSION=

# --- Local dev stack credentials (docker-compose.yaml) ---------------------
# These are sandbox-only defaults. docker-compose.yaml bakes the same values
# in as fallbacks, so the stack starts with one command and no .env. Override
# them here for a non-default local setup; never reuse them outside a sandbox.
# POSTGRES_USER=sbs
# POSTGRES_PASSWORD=sbs
# POSTGRES_DB=sbs_dev
# KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

# Git / GitHub
GITHUB_REMOTE=origin

# --- Internal API channel (Next.js cockpit → FastAPI) ----------------------
# Shared secret the FastAPI process requires in the Authorization: Bearer
# header on /v1/internal/*. The cockpit sends it from app/.env.local's
# SBS_INTERNAL_API_SECRET — note the different variable names on the two
# sides. The VALUES must match or every server-rendered cockpit page fails
# its data fetch. Generate one with: openssl rand -hex 32
# Required only when running the cockpit; the institution-facing API and the
# whole gate suite work without it.
SBS_API_INTERNAL_API_SECRET=

# Part 12 — agent pipeline. Defaults are conservative so the
# Prompt-11 regression suite stays green; scripts/demo.sh exports
# the demo-friendly overrides automatically.
# When enabled, BOTH ingestion tiers run the chain: Tier 1
# (POST /v1/complaints) dispatches it as a background task after the 201,
# and the Tier 2 arq worker runs it over each accepted batch row.
# SBS_API_AGENTS_PIPELINE_ENABLED=false    # default: false. Set true to trigger the chain after every ingest.
#
# Which model backend the agent runtime talks to. One of:
#
#   on_prem  (default) — self-hosted vLLM over an OpenAI-compatible API.
#                        The target state for the SBS workstation. Raises
#                        ProviderUnavailableError when the endpoint is unset
#                        or unreachable; it does NOT fall back to canned
#                        output any more.
#   cloud              — Azure OpenAI, using the four AZURE_OPENAI_* values
#                        above. Requires SBS_API_CLOUD_LEGAL_APPROVED=true.
#   replay             — pre-recorded fixtures from disk. Deterministic, and
#                        logs a WARNING on every single request saying the
#                        response is a replayed fixture, not live inference.
#                        Responses carry served_by="replay" into
#                        agent_runs.model_provider. This is what scripts/demo.sh
#                        uses.
#
# `mock` is test-only: it is accepted only inside a pytest process and is
# rejected here, because fabricated tool calls are indistinguishable from
# analysis once written to agent_runs. There is no silent fallback between
# any of these — a misconfigured provider fails loudly at boot.
#
# Resolved via Settings.agents_pipeline_provider; the alias
# SBS_API_AGENTS_PIPELINE_PROVIDER sets the same field.
# SBS_API_MODEL_PROVIDER=on_prem
#
# SBS_API_VLLM_BASE_URL=http://localhost:8001/v1
# SBS_API_VLLM_MODEL=<your-vllm-model-name> # e.g. an instruct-tuned 7B model served by vLLM
# SBS_API_VLLM_TIMEOUT_SECONDS=30
#
# --- cloud provider gate ---------------------------------------------------
# Required opt-in for SBS_API_MODEL_PROVIDER=cloud. CloudProvider refuses to
# construct while this is false.
#
# Setting it true ASSERTS: development use with synthetic data only, pending
# legal sign-off on PII isolation and data residency. It is an operator
# assertion, not a sign-off, and not a substitute for one. Supervisory-grade
# narratives must stay on the on_prem path until that review lands — see
# ADR 0001 §Divergence (amended) and ADR 0015.
# SBS_API_CLOUD_LEGAL_APPROVED=false
#
# Path to a PEM bundle for verifying the Azure TLS chain. Needed only where a
# corporate proxy terminates TLS with a root that certifi does not carry —
# the WBG network does, presenting pa-wbg-decrypt.worldbank.org issued by
# "WBG Cloud Root CA", and without this you get CERTIFICATE_VERIFY_FAILED.
# Export the machine's trust store with:
#   security find-certificate -a -p /Library/Keychains/System.keychain \
#     > certs/wbg-trust.pem        # macOS; certs/ is gitignored
# SBS_API_CLOUD_CA_BUNDLE=certs/wbg-trust.pem
#
# SBS_API_CLOUD_TIMEOUT_SECONDS=60         # per-request timeout
# SBS_API_CLOUD_MAX_RETRIES=2              # SDK retries on 429/5xx/connection errors
#
# One canary tool-call request at API boot when the pipeline is enabled;
# the process refuses to start if the provider is unreachable or returns no
# tool_calls. Skipped inside pytest.
# SBS_API_PROVIDER_HEALTHCHECK_ON_BOOT=true

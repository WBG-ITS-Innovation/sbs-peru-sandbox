# This project uses Azure OpenAI through WBG ITS, not personal OpenAI.
# Get your endpoint and deployment name from WBG IT or the Azure portal.
# WBG data-governance policy: model calls touching project content must go
# through WBG-tenanted Azure OpenAI. Personal openai.com keys are rejected
# by scripts/cross_review.py.
#
# Copy this file to .env (which is gitignored) and fill in real values.

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Git / GitHub
GITHUB_REMOTE=origin

# Part 12 — agent pipeline. Defaults are conservative so the
# Prompt-11 regression suite stays green; scripts/demo.sh exports
# the demo-friendly overrides automatically.
# SBS_API_AGENTS_PIPELINE_ENABLED=false    # default: false. Set true to trigger the chain after every ingest.
# SBS_API_MODEL_PROVIDER=on_prem           # one of: on_prem | replay | mock | cloud
# SBS_API_VLLM_BASE_URL=http://localhost:8001/v1
# SBS_API_VLLM_MODEL=<your-vllm-model-name> # e.g. an instruct-tuned 7B model served by vLLM
# SBS_API_VLLM_TIMEOUT_SECONDS=30
# SBS_API_CLOUD_LEGAL_APPROVED=false       # cloud provider still raises NotImplementedError when true.

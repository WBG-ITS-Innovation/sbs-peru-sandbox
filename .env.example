# =============================================================================
# .env.example — full runtime environment contract
# =============================================================================
#
# Copy to .env (which is gitignored) and fill in REQUIRED values; optional
# values can be left at their commented-out default. Each line below is marked
# [REQUIRED] / [OPTIONAL], and [SECRET] when the value should be treated as
# sensitive (rotate on disk exposure, never paste into chat or docs).
#
# Three audiences read this file:
#   1. The FastAPI service (api/sbs_api/). Reads SBS_API_* via pydantic-
#      settings (see api/sbs_api/config.py — source of truth).
#   2. The Next.js supervisor UI (app/). Reads its own KEYCLOAK_* /
#      SBS_INTERNAL_API_* / SBS_DEMO_* (also documented in app/.env.example;
#      pinned here as a single-pane reference).
#   3. The harness scripts (scripts/cross_review.py, scripts/close_prompt.py,
#      scripts/demo.sh). Read AZURE_OPENAI_* + GITHUB_REMOTE.
#
# The well-known sandbox webhook-listener HMAC values
# (LISTENER_OUTBOUND_SECRET_*) are intentional dev-only constants set by
# docker-compose.yaml and dev-seed.sql; they are NOT contributor-set and are
# deliberately omitted from this file.

# =============================================================================
# Azure OpenAI — REQUIRED for harness LLM calls (cross-reviews, etc.)
# =============================================================================
# This project routes all model calls through the corporate Azure OpenAI
# tenancy. Personal openai.com keys are rejected by scripts/cross_review.py.
# Get values from your corporate IT / Azure portal.

AZURE_OPENAI_API_KEY=          # [REQUIRED] [SECRET] rotate on any disk exposure
AZURE_OPENAI_ENDPOINT=         # [REQUIRED] e.g. https://<your-aoai>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=       # [REQUIRED] e.g. gpt-5.4
AZURE_OPENAI_API_VERSION=      # [REQUIRED] e.g. 2024-06-01

# =============================================================================
# Git / GitHub — harness defaults
# =============================================================================

GITHUB_REMOTE=origin            # [OPTIONAL] git remote name used by close_prompt.py

# =============================================================================
# FastAPI service — SBS_API_* (env_prefix in api/sbs_api/config.py)
# =============================================================================
# Defaults below mirror Settings() defaults; uncomment only what you need to
# override. Every var is OPTIONAL unless flagged [REQUIRED]; the FastAPI
# process refuses to start if a [REQUIRED] value is missing in a non-dev
# environment.

# --- Runtime ---
# SBS_API_API_VERSION=0.1.0
# SBS_API_SCHEMA_VERSION=v0.1.0
# SBS_API_BUILD_SHA=0000000
# SBS_API_ENVIRONMENT=dev                          # dev | test | staging | prod

# --- Database (asyncpg) ---
# SBS_API_DATABASE_URL=postgresql+asyncpg://sbs:sbs@localhost:5432/sbs_dev   # pragma: allowlist secret  -- [SECRET in prod] dev default OK locally
# SBS_API_DB_POOL_SIZE=10
# SBS_API_DB_POOL_MAX_OVERFLOW=20

# --- Request limits ---
# SBS_API_MAX_REQUEST_BODY_BYTES=262144            # 256 KiB default per ADR 0028

# --- Auth stub (Prompt 6 stub; real wiring in Prompt 7) ---
# SBS_API_AUTH_STUB_ENABLED=false                  # true in scripts/run-api.sh local
# SBS_API_AUTH_STUB_INSTITUTION_ID=SBS-001234

# --- Idempotency-key sweeper ---
# SBS_API_IDEMPOTENCY_TTL_SECONDS=86400            # 24h
# SBS_API_IDEMPOTENCY_SWEEP_ENABLED=true
# SBS_API_IDEMPOTENCY_SWEEP_INTERVAL_SECONDS=3600
# SBS_API_IDEMPOTENCY_SWEEP_GRACE_SECONDS=300

# --- Health probe (/health) ---
# SBS_API_READINESS_DB_PING_TIMEOUT_MS=200
# SBS_API_READINESS_CACHE_SECONDS=1.0

# --- RFC 9457 problem details ---
# SBS_API_PROBLEM_TYPE_NAMESPACE=https://sbs.gob.pe/errors

# --- Observability (structlog + OpenTelemetry) ---
# SBS_API_LOG_FORMAT=console                       # console | json (json in prod)
# SBS_API_LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR
# SBS_API_OTEL_SERVICE_NAME=sbs-suptech-api
# SBS_API_OTEL_TRACES_EXPORTER=console             # otlp | console | none
# SBS_API_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Canonical OpenAPI serving ---
# SBS_API_CANONICAL_OPENAPI_PATH=api/openapi/sbs-api-v1.yaml

# --- mTLS (ADR 0031) ---
# SBS_API_MTLS_MODE=disabled                       # direct | proxy | disabled
# SBS_API_DISABLE_MTLS_FOR_TESTS=false             # test-only escape hatch
# SBS_API_PROXY_TRUSTED_XFCC_HEADER=x-forwarded-client-cert

# --- HMAC request signing (ADR 0027 amendment) ---
# SBS_API_HMAC_SECRET_ROTATION_GRACE_SECONDS=3600  # 1h overlap when rotating
# SBS_API_HMAC_TIMESTAMP_SKEW_SECONDS=300          # 5min skew tolerance
# SBS_API_HMAC_REPLAY_CACHE_TTL_SECONDS=600        # Redis replay cache TTL
# SBS_API_REDIS_URL=redis://localhost:6379/0

# --- Tier 2 batch (ADR 0034) ---
# SBS_API_MAX_BATCH_FILE_BYTES=52428800            # 50 MiB
# SBS_API_BATCH_STORAGE_PATH=data/batches
# SBS_API_BATCH_STORAGE_PRUNE_DAYS=7

# --- Internal API (Next.js supervisor UI → FastAPI) ---
# Required when the supervisor UI is deployed; the /v1/internal/audit
# endpoint returns 404 when this is unset. MUST match SBS_INTERNAL_API_SECRET
# on the Next.js side. Generate with: openssl rand -hex 32
SBS_API_INTERNAL_API_SECRET=    # [REQUIRED-when-supervisor-UI-deployed] [SECRET]

# --- Outbound webhook delivery (ADR 0035) ---
# SBS_API_ALLOW_INSECURE_WEBHOOK_URLS=false        # true in sandbox docker-compose only
# SBS_API_WEBHOOK_REQUEST_TIMEOUT_SECONDS=10.0

# --- Rate limiting (ADR 0033) ---
# SBS_API_RATE_LIMIT_TIER_LARGE_PER_MINUTE=1000
# SBS_API_RATE_LIMIT_TIER_SMALL_PER_MINUTE=100
# SBS_API_RATE_LIMIT_TOKEN_ENDPOINT_PER_MINUTE=50

# =============================================================================
# Next.js supervisor UI — KEYCLOAK_* / SBS_INTERNAL_API_* / SBS_DEMO_*
# =============================================================================
# Read by app/src/auth/config.ts. Defaults below match the docker-compose
# dev stack; production overlays set Helm values + secrets. Mirrored in
# app/.env.example for the app-only workflow.

# --- Keycloak (sandbox IdP) ---
# KEYCLOAK_BASE_URL=http://localhost:8081
# KEYCLOAK_REALM=sbs-demo
# KEYCLOAK_CLIENT_ID=sbs-supervisor-ui
# KEYCLOAK_REDIRECT_URI=http://localhost:3000/app/api/auth/callback
# KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/app/login

# --- Server-to-server FastAPI calls from Next.js ---
# Base URL of the FastAPI service. server-to-server (browser-direct calls
# go straight to FastAPI).
# SBS_INTERNAL_API_BASE_URL=http://localhost:8000
# Shared secret matching SBS_API_INTERNAL_API_SECRET above.
SBS_INTERNAL_API_SECRET=        # [REQUIRED-when-supervisor-UI-deployed] [SECRET]

# --- Demo-mode toggle ---
# Enables the ROPC persona switcher per ADR 0040 §D8. Off in production
# (the persona switch route returns 404 when this is false).
# SBS_DEMO_MODE=true

# --- Demo persona password overrides ---
# Override the in-realm passwords in infra/keycloak/realm-sbs-demo.json
# without re-importing. Defaults match the realm credentials (sandbox-only).
# SBS_DEMO_SUPERVISOR_PASSWORD=supervisor-demo-2026   # [SECRET — sandbox only]
# SBS_DEMO_ANALYST_PASSWORD=analyst-demo-2026         # [SECRET — sandbox only]
# SBS_DEMO_UNIT_HEAD_PASSWORD=unit-head-demo-2026     # [SECRET — sandbox only]

# =============================================================================
# Sandbox-only / dev-stack constants (NOT contributor-set)
# =============================================================================
# The webhook-listener (sandbox-only docker-compose service) has hard-coded
# HMAC secrets it shares with dev-seed.sql:
#   LISTENER_OUTBOUND_SECRET_SBS_001234
#   LISTENER_OUTBOUND_SECRET_SBS_005678
#   LISTENER_OUTBOUND_SECRET_SBS_009012
# Set in docker-compose.yaml and allowlisted in .gitleaks.toml. Do not set
# these here; they are demo constants, not user secrets, and the listener
# service is dev-only.

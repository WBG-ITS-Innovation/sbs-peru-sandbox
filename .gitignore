# Local-only cross-review notes (not for commit)
docs/reviews/*.local.md

# Allow example envs
!.env.example
# Certificate bundles — never commit (see docs/setup/corporate-proxy-and-zscaler.md)
certs/

# Dev CA — generated by scripts/dev-ca.sh; sandbox-only, never commit
dev-ca/

# Tier 2 batch CSV uploads — sandbox-only, regenerated per upload.
# The golden sample under data/synthetic-corpus-golden/ is committed; the
# full corpus and per-batch uploads are not.
data/batches/
data/synthetic-corpus/

# Webhook listener readiness file (shared docker volume mount point)
webhook-state/

# scripts/demo.sh writes per-run outputs to tmp/demo-run/<timestamp>/
# (summary.json, corpus, listener log captures). Never committed.
tmp/

# Standards pack — `make standards-pack` regenerates these subdirectories
# from authoritative sources elsewhere in the repository (api/openapi/,
# sdk-helpers/, etc.) plus a freshly-captured git_commit and generated_at.
# Committing them would create churn on every build. Sources of truth
# that the build pipeline reads stay committed; outputs do not.
# See ADR 0039 and standards-pack/README.md.
#
# Recipes (standards-pack/recipes/) are HAND-AUTHORED source content,
# not regenerated. They stay committed.
standards-pack/manifest.json
standards-pack/checksums.sha256
standards-pack/openapi/
standards-pack/schemas/
standards-pack/catalogs/
standards-pack/sdk-helpers/
standards-pack/examples/

# Local demo secrets
.demo-internal-api-secret
app/.env.local

# Real SBS Annex 1-A sample — PII-bearing (even with partial
# pre-anonymization). Operator places the file here locally; never
# commit. See docs/demo/2026-05-27-demo-ready.md.
data/sbs_sample/

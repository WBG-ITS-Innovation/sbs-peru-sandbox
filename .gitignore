# Local-only cross-review notes (not for commit)
docs/reviews/*.local.md

# Allow example envs
!.env.example
# Certificate bundles — never commit (see docs/setup/corporate-proxy-and-zscaler.md)
certs/

# Dev CA — generated by scripts/dev-ca.sh; sandbox-only, never commit
dev-ca/

# Tier 2 batch CSV uploads — sandbox-only, regenerated per upload.
# The golden sample under data/synthetic-corpus-golden/ is committed; the
# full corpus and per-batch uploads are not.
data/batches/
data/synthetic-corpus/

# Webhook listener readiness file (shared docker volume mount point)
webhook-state/

# scripts/demo.sh writes per-run outputs to tmp/demo-run/<timestamp>/
# (summary.json, corpus, listener log captures). Never committed.
tmp/

# Standards pack — `make standards-pack` regenerates these subdirectories
# from authoritative sources elsewhere in the repository (api/openapi/,
# sdk-helpers/, etc.) plus a freshly-captured git_commit and generated_at.
# Committing them would create churn on every build. Sources of truth
# that the build pipeline reads stay committed; outputs do not.
# See ADR 0039 and standards-pack/README.md.
#
# Recipes (standards-pack/recipes/) are HAND-AUTHORED source content,
# not regenerated. They stay committed.
standards-pack/manifest.json
standards-pack/checksums.sha256
standards-pack/openapi/
standards-pack/schemas/
standards-pack/catalogs/
standards-pack/sdk-helpers/
standards-pack/examples/

# Local demo secrets
.demo-internal-api-secret
app/.env.local

# Backup files — `.env.backup`, `docker-compose.yaml.bak`, etc. These tend to
# be created during local debugging; slipping one through into a commit would
# re-leak whatever the live file contained at that moment. Series 1 scrub.
*.bak
*.backup

# Local-only sandbox bundles and tunneling binaries that occasionally land
# in the repo root from quick experiments. Never to be committed. Series 1.
/bore
/cloudflared
/dev-ca.zip

# Real SBS sample spreadsheets used for offline analysis on the maintainer's
# machine. Not synthetic — must never be committed. Series 1 scrub.
data/sbs_sample/

# Anexo 1-A reglamento PDF. Source 4a5b0e1 committed `annexo.pdf` as the
# spec-of-record for the DQ code lists; the agent salvage dropped it pending
# human provenance verification (must be the public Res. SBS 04036-2022
# reglamento, not internal SBS material). See release-evidence/track-b-salvage-TODO.md.
annexo.pdf

# release-evidence/ — internal build-and-salvage notes. Three of them carry
# credential-handling detail and maintainer machine paths; none of it is
# reference material for anyone integrating with the sandbox. Untracked here
# and pinned so it cannot come back.
release-evidence/

# .scratch — local UI artifacts and one-off mockups. Already excluded via
# .git/info/exclude on the maintainer's clone; pinned here so it applies to
# every clone.
.scratch/

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of ``GET /v1/batches/{batch_id}``.",
  "properties": {
    "batch_id": {
      "pattern": "^batch_[A-Za-z0-9]{16,32}$",
      "title": "Batch Id",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set when status is 'failed'. Short human-readable message; details (e.g. exception type, stack) live in the structlog stream, not in the API response.",
      "title": "Failure Reason"
    },
    "institution_id": {
      "pattern": "^SBS-\\d{4,6}$",
      "title": "Institution Id",
      "type": "string"
    },
    "row_count_accepted": {
      "minimum": 0,
      "title": "Row Count Accepted",
      "type": "integer"
    },
    "row_count_rejected": {
      "minimum": 0,
      "title": "Row Count Rejected",
      "type": "integer"
    },
    "row_count_submitted": {
      "minimum": 0,
      "title": "Row Count Submitted",
      "type": "integer"
    },
    "status": {
      "description": "Lifecycle state. ADR 0034 §state-machine: pending → processing → complete | failed. Once terminal, the state does not change.",
      "enum": [
        "pending",
        "processing",
        "complete",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "institution_id",
    "status",
    "submitted_at",
    "row_count_submitted",
    "row_count_accepted",
    "row_count_rejected"
  ],
  "title": "BatchStatus",
  "type": "object"
}

# SBS SupTech supervisor UI — environment variables
#
# Copy to .env.local for local development. Production overlays set
# these via Helm values + Kubernetes secrets.

# ---- Keycloak (sandbox IdP) -----------------------------------------------
# Externally-reachable Keycloak URL. Docker-compose maps Keycloak's
# internal :8080 to host :8081, hence the default below.
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=sbs-demo
KEYCLOAK_CLIENT_ID=sbs-supervisor-ui
KEYCLOAK_REDIRECT_URI=http://localhost:3000/app/api/auth/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/app/login

# ---- Internal API (Next.js → FastAPI server-to-server) --------------------
# Base URL of the FastAPI service. Different from any browser-facing
# URL because Next.js calls FastAPI server-to-server, not via the user's
# browser.
SBS_INTERNAL_API_BASE_URL=http://localhost:8000
# Shared secret used in the Authorization: Bearer header when Next.js
# calls FastAPI's /v1/internal/* endpoints. Set the SAME value in the
# FastAPI process's SBS_API_INTERNAL_API_SECRET env var.
# Generate a fresh value with: openssl rand -hex 32
SBS_INTERNAL_API_SECRET=replace-me-with-openssl-rand-hex-32

# ---- Python interpreter for server-side routes ----------------------------
# Several BFF routes shell out to scripts under the repo's scripts/ dir
# (avoids bundling Postgres drivers into the Next.js runtime). Leave unset
# to use <repo>/.venv/bin/python. Set it when your interpreter lives
# somewhere else — a uv env outside the repo, a conda env, a container
# image with a system Python, or Windows (Scripts/python.exe).
# SBS_PYTHON_BIN=/absolute/path/to/python

# ---- Demo-mode toggles ----------------------------------------------------
# When true, enables the persona switcher (ADR 0040 §D8). Off in prod.
SBS_DEMO_MODE=true

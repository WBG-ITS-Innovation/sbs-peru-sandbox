{
  "name": "@sbs/webhooks-helper",
  "version": "0.1.0",
  "description": "Webhook signature verification helper for the SBS SupTech Complaints API.",
  "license": "LicenseRef-sandbox-pending-legal-review",
  "author": "SBS Peru via WBG ITS Innovation Office",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build:cjs": "tsc -p tsconfig.cjs.json && node ./scripts/rename-cjs-to-cjs.js",
    "build:esm": "tsc -p tsconfig.esm.json && node ./scripts/rename-esm-to-mjs.js",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
